# Copy to .env and fill in real values. .env is gitignored.
#
# OpenRouter key enables the scout layer (GitHub audit + LLM re-engineering).
# Without it, the watcher still harvests + polls but won't scout external skills.
OPENROUTER_API_KEY=

# Optional overrides
# CLAUDE_DIR=C:/Claude
# TOOLMASTER_HOME=~/.toolmaster
# TOOLMASTER_MODEL=anthropic/claude-haiku-4.5
